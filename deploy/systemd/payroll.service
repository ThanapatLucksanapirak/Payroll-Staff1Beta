[Unit]
Description=Payroll app
Documentation=file:///opt/payroll/deploy/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=payroll
Group=payroll
EnvironmentFile=/etc/payroll/payroll.env
WorkingDirectory=/opt/payroll/current
ExecStart=/opt/payroll/node/bin/node --enable-source-maps dist/index.cjs
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
LimitNOFILE=65536
# Memory guard: restart instead of taking the whole box down.
MemoryMax=1536M

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/payroll
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
